# Kopieren nach .env und anpassen:  cp .env.example .env
# ACHTUNG: .env enthält Geheimnisse und gehört NICHT ins Git (steht in .gitignore).

# --- Zugriffsschutz (standardmäßig AN) ------------------------------------------------------------------
# Passwort (mind. 8 Zeichen; besser lang). Ohne Angabe wird bei jedem Start ein zufälliges erzeugt und ins Log geschrieben.
FAHRRADNAVI_PASSWORD=
# Alternativ ein Hash statt Klartext:  docker compose run --rm --no-deps fahrradnavi fahrradnavi hash-password
# Den Hash in EINFACHE Anführungszeichen setzen (wegen der '$'-Zeichen):  FAHRRADNAVI_PASSWORD_HASH='pbkdf2_sha256$600000$...'
FAHRRADNAVI_PASSWORD_HASH=

# Login nur aus bestimmten Netzen erlauben (kommagetrennt, CIDR). Leer = von überall (nur mit Passwort).
# Beispiele: eigenes Heimnetz + VPN:  192.168.0.0/16,10.8.0.0/24     einzelne feste IP: 203.0.113.7
FAHRRADNAVI_ALLOWED_NETS=

# Sperre gegen Passwort-Raten: nach N Fehlversuchen wird die IP gesperrt (Dauer verdoppelt sich bei Wiederholung)
FAHRRADNAVI_MAX_LOGIN_FAILURES=5
FAHRRADNAVI_LOCKOUT_SECONDS=900
# Wie lange eine Anmeldung gültig bleibt (Stunden)
FAHRRADNAVI_SESSION_HOURS=168
# Optionaler Token für Skripte (Authorization: Bearer ...), mind. 20 Zeichen:  openssl rand -hex 24
FAHRRADNAVI_API_TOKEN=

# --- HTTPS (Profil "https") -----------------------------------------------------------------------------
FAHRRADNAVI_DOMAIN=navi.example.org

# --- Karte / Daten ----------------------------------------------------------------------------------------
# Gebiet für den Builder: starnberg | oberbayern | bayern
FAHRRADNAVI_REGION=starnberg
# Standard-Kachelserver von OpenStreetMap ist nur für geringe Last gedacht – für öffentlichen Betrieb eigenen Anbieter eintragen
# Leer lassen = Standard. Beispiel eigener Anbieter: https://tiles.example.org/{z}/{x}/{y}.png
FAHRRADNAVI_TILE_URL=
# Port auf dem Host (nur 127.0.0.1)
FAHRRADNAVI_PORT=8000
